<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros4hri_rula_assessor</name>
  <version>0.0.0</version>
  <description>Real-time RULA ergonomic assessment from REP-155 (ROS4HRI) body tracking (ARISE Tele-Craft Module B)</description>
  <maintainer email="toma.dimcic@gmail.com">Tomislav Dimcic</maintainer>
  <license>LGPL-3.0-or-later</license>

    <exec_depend>rclpy</exec_depend>
  <exec_depend>hri_msgs</exec_depend>
  <exec_depend>rula_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>human_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
